{
	"name": "live-resource",
	"version": "0.0.1",
	"description": "Framework-neutral live resource synchronization primitives.",
	"keywords": [
		"cache",
		"optimistic-ui",
		"realtime",
		"sse",
		"sync",
		"typescript"
	],
	"author": "Sravan Suresh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/srav001/live-resource.git"
	},
	"bugs": {
		"url": "https://github.com/srav001/live-resource/issues"
	},
	"homepage": "https://github.com/srav001/live-resource#readme",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"lint": "vp lint --fix",
		"format": "vp fmt",
		"validate": "vp check && vp pack",
		"prepack": "pnpm run validate"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		"./client/core": {
			"types": "./dist/client/core.d.ts",
			"import": "./dist/client/core.js",
			"default": "./dist/client/core.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		},
		"./shared": {
			"types": "./dist/shared.d.ts",
			"import": "./dist/shared.js",
			"default": "./dist/shared.js"
		}
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
		"vite-plus": "0.2.4"
	},
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"packageManager": "pnpm@11.1.2",
	"publishConfig": {
		"access": "public"
	}
}
