{
	"name": "sync-resource",
	"version": "2.0.0",
	"description": "Server-authoritative resource sync with caching, optimistic updates, realtime delivery and recovery, while remaining framework agnostic.",
	"keywords": [
		"cache",
		"client-cache",
		"data-sync",
		"framework-agnostic",
		"optimistic-updates",
		"outbox",
		"realtime",
		"resource-sync",
		"server-sent-events",
		"sse",
		"state-management",
		"sync",
		"typescript"
	],
	"author": "Sravan Suresh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/srav001/sync-resource.git"
	},
	"bugs": {
		"url": "https://github.com/srav001/sync-resource/issues"
	},
	"homepage": "https://github.com/srav001/sync-resource#readme",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"lint": "vp lint --fix",
		"format": "vp fmt",
		"test": "vp test",
		"validate": "vp check && vp test && vp pack",
		"prepack": "pnpm run validate"
	},
	"files": [
		"dist",
		"docs",
		"AGENTS.md",
		"LICENSE",
		"README.md"
	],
	"exports": {
		"./client/core": {
			"types": "./dist/client/core.d.ts",
			"import": "./dist/client/core.js",
			"default": "./dist/client/core.js"
		},
		"./client/react": {
			"types": "./dist/client/react.d.ts",
			"import": "./dist/client/react.js",
			"default": "./dist/client/react.js"
		},
		"./client/solid": {
			"types": "./dist/client/solid.d.ts",
			"import": "./dist/client/solid.js",
			"default": "./dist/client/solid.js"
		},
		"./client/vue": {
			"types": "./dist/client/vue.d.ts",
			"import": "./dist/client/vue.js",
			"default": "./dist/client/vue.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		},
		"./server/effect": {
			"types": "./dist/server/effect.d.ts",
			"import": "./dist/server/effect.js",
			"default": "./dist/server/effect.js"
		},
		"./shared": {
			"types": "./dist/shared.d.ts",
			"import": "./dist/shared.js",
			"default": "./dist/shared.js"
		}
	},
	"peerDependencies": {
		"effect": ">=4.0.3 <5",
		"react": ">=18.0.0",
		"solid-js": ">=1.9.0 <2.0.0",
		"vue": ">=3.2.0 <4.0.0"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oxlint/plugins": "1.87.0",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.3",
		"effect": "4.0.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"solid-js": "1.9.17",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"vue": "3.5.43"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "pnpm@11.1.2",
	"publishConfig": {
		"access": "public"
	}
}
